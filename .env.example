# ---------- server ----------
# Bind address. Keep 127.0.0.1 unless a worker on another machine (e.g. the
# Windows Android worker) must reach this server - then put it behind TLS.
LAB_HOST=127.0.0.1
LAB_PORT=4300
# Where SQLite, uploaded builds and run artifacts live.
LAB_DATA_DIR=./data
# HMAC key that signs short-lived worker session tokens. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAB_SERVER_SECRET=change-me-to-32-random-bytes-hex
# Bearer token for the dashboard and the CLI.
LAB_DASHBOARD_TOKEN=change-me-dashboard-token
# Long-lived secret a worker presents ONCE to obtain a 15-minute session token.
LAB_WORKER_ENROLLMENT_SECRET=change-me-enrollment-secret
# How many device tasks may run at the same time (across all workers).
LAB_MAX_PARALLEL_TASKS=4
# Device lease length; the scheduler renews it while a task is alive.
LAB_LEASE_SECONDS=120

# ---------- worker ----------
LAB_SERVER_URL=http://127.0.0.1:4300
LAB_WORKER_NAME=mac-studio-1
# Optional overrides; defaults are detected per OS.
# ANDROID_HOME=/Users/you/Library/Android/sdk
# LAB_MAESTRO_BIN=/Users/you/.maestro/bin/maestro
# Worker scratch space (downloaded builds, Maestro output).
LAB_WORKER_DIR=./data/worker
